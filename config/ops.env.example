# Copia este archivo como config/ops.env y ajusta los valores.

# Backup
BACKUP_SOURCE=/etc
BACKUP_DEST=/var/backups/linux-ops-toolkit
BACKUP_RETENTION_DAYS=7
BACKUP_NAME=backup

# Reporte de disco
SCAN_PATH=/home
TOP_N=10

# Limpieza de logs
LOG_DIR=/var/log
LOG_PATTERN=*.log
LOG_MAX_AGE_DAYS=30
DRY_RUN=1

# Servicios separados por espacios
SERVICES="sshd.service crond.service"
